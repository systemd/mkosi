#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# End of first stage of build:
# - built UKI is in $OUTPUTDIR
# - get PCR policy digests if any, or PE hash(es) with pesign
# - pack them up in a cpio as OBS expects and store them in OTHER/
# - create minimal recipe for second stage that will continue from here

set -e

declare -a UKIS
mapfile -t UKIS < <(find "$OUTPUTDIR" -type f -name "*.efi" -printf '%P\n')
declare -a KERNELS
mapfile -t KERNELS < <(find "$OUTPUTDIR" -type f -name "vmlinu*" -printf '%P\n')
declare -a ROOTHASHES
mapfile -t ROOTHASHES < <(find "$OUTPUTDIR" -type f -name "*.roothash" -printf '%P\n')
declare -a DDIS
mapfile -t DDIS < <(find "$OUTPUTDIR" -type f -name "*.raw*")

if ((${#UKIS[@]} == 0)) && ((${#KERNELS[@]} == 0)) && ((${#ROOTHASHES[@]} == 0)) && ((${#DDIS[@]} == 0)); then
    echo "No unsigned files found, exiting"
    exit 0
fi

nss_db="$PWD/nss-db"
# certutil will fail if it's called twice
rm -rf "$nss_db"
mkdir -p "$nss_db" hashes
certutil -N -d sql:"$nss_db" --empty-password

# When a single build has multiple images, postoutput is called for each image,
# so make sure the hashes.cpio from the previous stages gets its content preserved
if [ -f /usr/src/packages/OTHER/hashes.cpio.rsasign ]; then
    pushd hashes
    cpio -idm </usr/src/packages/OTHER/hashes.cpio.rsasign
    popd
fi

for f in "${UKIS[@]}"; do
    test -f "${OUTPUTDIR}/${f}" || continue
    if [ -f "${OUTPUTDIR}/${f%.efi}.pcrs" ]; then
        mkdir -p "hashes/pcrs/$f"
        while read -r tbs; do
            echo -n "$tbs" | tr '[:lower:]' '[:upper:]' | basenc --base16 --decode >"hashes/pcrs/${f}/${tbs}"
        done < <(jq -r 'to_entries[] | .value[] | .tbs // .pol' <"${OUTPUTDIR}/${f%.efi}.pcrs")
    else
        mkdir -p "$(dirname "hashes/ukis/$f")"
        pesign --force -n sql:"$nss_db" -i "${OUTPUTDIR}/${f}" -E "hashes/ukis/$f"
    fi
done

for f in "${KERNELS[@]}"; do
    test -f "${OUTPUTDIR}/${f}" || continue
    mkdir -p "$(dirname "hashes/kernels/$f")"
    pesign --force -n sql:"$nss_db" -i "${OUTPUTDIR}/${f}" -E "hashes/kernels/$f"
done

repart_dirs=("$OUTPUTDIR/$OUTPUT.repart.d")
if [[ ! -d ${repart_dirs[0]} ]]; then
    mapfile -t repart_dirs < <(jq -r '.RepartDirectories[]' "$MKOSI_CONFIG")
fi
declare -A repart_images=()
for f in "${ROOTHASHES[@]}"; do
    test -f "${OUTPUTDIR}/${f}" || continue
    # OBS does not forward the Output= symlink. Keep the actual image name with its roothash.
    ddi="$(realpath "$OUTPUTDIR/${f%.roothash}")"
    mkdir -p "hashes/roothashes/${ddi##*/}"
    cp "${OUTPUTDIR}/$f" "hashes/roothashes/${ddi##*/}/"
    if ((${#repart_dirs[@]} > 0)); then
        repart_images[${f%.roothash}]="${ddi##*/}"
    fi
done

split_disk=
split_esp=
if jq -e '.Format == "disk" and (.SplitArtifacts | index("partitions") != null)' "$MKOSI_CONFIG" >/dev/null; then
    split_disk="$(realpath -e "$OUTPUTDIR/$OUTPUT")"
    # repart inserts the partition name before the final .raw suffix (if any).
    image="${split_disk%.zst}"
    if [[ $image == *.raw ]]; then
        split_esp="${image%.raw}.esp.raw"
    else
        split_esp="$image.esp"
    fi
fi

# Handle bootloaders separately from UKIs
found_esp=0
for ddi in "${DDIS[@]}"; do
    test -f "$ddi" || continue
    # Skip over split artifacts, if any
    [[ ${ddi%.zst} == "$split_esp" ]] && continue
    [[ "$ddi" =~ \.usr- ]] && continue
    [[ "$ddi" =~ \.root- ]] && continue
    [[ "$ddi" =~ -verity ]] && continue

    if [[ $ddi == *.zst ]]; then
        unzstd --force "${ddi}"
    fi
    offset="$(systemd-repart --json=short "${ddi%.zst}" | jq -r '.[] | select(.type == "esp") | .offset')"
    if [ -z "$offset" ] || [ "$offset" = "null" ]; then
        if [[ $ddi == *.zst ]]; then
            rm -f "${ddi%.zst}"
        fi
        continue
    fi

    # Record the ESP for boot file signing and enrollment in the follow-up.
    printf '%s\n' "$offset" >"$ddi.esp-offset"
    rm -rf EFI
    mcopy -s -i "${ddi%.zst}@@${offset}" ::EFI EFI || true
    found_esp=1
    # A disk without verity may also need its split ESP refreshed after signing.
    if [[ $ddi == "$split_disk" ]]; then
        repart_images[$OUTPUT]="${ddi##*/}"
    fi

    # UKIs are handled separately
    rm -rf EFI/Linux

    while read -r BOOTLOADER; do
        mkdir -p "hashes/bootloaders/$(basename "${ddi%.zst}")/$(dirname "$BOOTLOADER")"
        pesign --force -n sql:"$nss_db" -i "$BOOTLOADER" -E "hashes/bootloaders/$(basename "${ddi%.zst}")/$BOOTLOADER"
    done < <(find EFI -type f -iname '*.efi')

    if [[ $ddi == *.zst ]]; then
        rm -f "${ddi%.zst}"
    fi
    rm -rf EFI
done

for stem in "${!repart_images[@]}"; do
    work="$(mktemp -d)"
    mkdir "$work/definitions"
    if ((${#repart_dirs[@]} > 0)); then
        for dir in "${repart_dirs[@]}"; do
            cp -r "$dir/." "$work/definitions/"
        done
        if [[ -f "$OUTPUTDIR/$stem.roothash" ]]; then
            cp "$OUTPUTDIR/$stem.roothash" "$work/roothash"
        fi
    else
        # With mkosi's default disk layout there is no custom ESP split name.
        printf '[Partition]\nType=esp\n' >"$work/definitions/00-esp.conf"
    fi
    printf '%s\n' "${repart_images[$stem]}" >"$work/image"
    jq -r '"--architecture=\(.Architecture)", (.SectorSize | select(.) | "--sector-size=\(.)"),
           (if .SplitArtifacts | index("partitions") then "--split=yes" else empty end)' \
        "$MKOSI_CONFIG" >"$work/options"
    if [[ -f "$OUTPUTDIR/$stem.osrelease" ]]; then
        mkdir -p "$work/usr/lib"
        cp "$OUTPUTDIR/$stem.osrelease" "$work/usr/lib/os-release"
    fi
    tar cf "$OUTPUTDIR/$stem.repart.tar" -C "$work" .
    rm -r "$work"
done

# If there is an ESP prepare the authvars for self-enrollment
if [ "$found_esp" -eq 1 ]; then
    mkdir -p hashes/authvars
    pushd hashes/authvars 2>/dev/null
    # Same as the GUID used by bootctl
    guid=a5c059a1-94e4-4aa7-87b5-ab155c2bf072
    cert-to-efi-sig-list -g "$guid" /usr/src/packages/SOURCES/_projectcert.crt db.esl
    cp db.esl KEK.esl
    cp db.esl PK.esl

    # If there are any additional certs, concatenate them
    for cert in /usr/src/packages/SOURCES/*/mkosi.uefi.db/*.crt; do
        test -f "$cert" || continue
        cert-to-efi-sig-list -g "$guid" "$cert" tmp.esl
        cat tmp.esl >>db.esl
        rm -f tmp.esl
    done
    for cert in /usr/src/packages/SOURCES/*/mkosi.uefi.KEK/*.crt; do
        test -f "$cert" || continue
        cert-to-efi-sig-list -g "$guid" "$cert" tmp.esl
        cat tmp.esl >>KEK.esl
        rm -f tmp.esl
    done

    for i in *.esl; do
        sign-efi-sig-list -o -g "$guid" -t "$(date -d "@${SOURCE_DATE_EPOCH:-0}" "+%Y-%m-%d %H:%M:%S")" "${i%.esl}" "$i" "${i%.esl}.auth"
    done
    popd 2>/dev/null
fi

# Pack everything into a CPIO archive and place it where OBS expects it
pushd hashes
find . -type f | cpio -H newc -o >"$OUTPUTDIR/hashes.cpio.rsasign"
popd
rm -rf hashes "$nss_db"

echo "Staging the following files for signing:"
cpio -t <"$OUTPUTDIR/hashes.cpio.rsasign"

# The second stage will not do a full rebuild, but only attach signatures to the existing UKI
cat >"$OUTPUTDIR/mkosi.conf" <<EOF
[Distribution]
Distribution=custom
[Output]
Format=none
ImageId=$IMAGE_ID
[Include]
Include=mkosi-obs
[Build]
# The follow-up uses the worker's read-only /usr, which already includes SOURCES.
SandboxTrees=
BuildSources=/usr/src/packages/OTHER:/usr/src/packages/OTHER
EOF
