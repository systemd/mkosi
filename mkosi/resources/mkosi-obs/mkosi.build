#!/usr/bin/env bash
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Second stage of build:
# - signed hashes are in cpio archive in SOURCES/ together with artifacts from previous build
# - if there are PCR policies to attach, do so and then prepare the hashes of the UKIs themselves
# - if not, attach the signatures to the UKI(s) with pesign
# - remove shasums of previous artifacts, given we are re-creating them after this step
# - place artifacts from previous builds and signed UKI in output directory

set -e

if [ ! -f /usr/src/packages/SOURCES/hashes.cpio.rsasign.sig ]; then
    exit 0
fi

echo "Signed files to be attached:"
cpio -t </usr/src/packages/SOURCES/hashes.cpio.rsasign.sig
cpio -t </usr/src/packages/SOURCES/hashes.cpio.rsasign
mkdir -p hashes
pushd hashes
cpio -idm </usr/src/packages/SOURCES/hashes.cpio.rsasign.sig
cpio -idm </usr/src/packages/SOURCES/hashes.cpio.rsasign
if [ -f /usr/src/packages/SOURCES/deferred-signatures.cpio ]; then
    cpio -idm </usr/src/packages/SOURCES/deferred-signatures.cpio
fi
popd

OUTPUTDIR=/work/src/usr/src/packages/OTHER

# OBS signs a hash without certificate information so it cannot simply be
# attached to the PE binaries, certificate metadata has to be provided separately
# so we need to create a certutil db and import the certificate manually
rm -rf nss-db
mkdir nss-db
nss_db="$PWD/nss-db"
certutil -N -d sql:"$nss_db" --empty-password

for f in /usr/src/packages/SOURCES/*; do
    case "${f##*/}" in
        *.sha*|mkosi.conf|hashes.cpio.rsasign*|deferred-signatures.cpio) continue ;;
        "$IMAGE_ID"*|*raw*|*efi*|vmlinu*|*.pcrs|*.repart.tar|*.osrelease) cp -r "$f" "$OUTPUTDIR/" ;;
    esac
done

# Attach PCR signatures before computing the UKI's PE signing request.
while read -r SIG; do
    uki="$OUTPUTDIR/$(basename "$(dirname "${SIG%.sig}")")"
    pcrs="${uki%.efi}.pcrs"
    tbs="$(basename "${SIG%.sig}")"

    test -f "${pcrs}"

    jq -c --arg tbs "$tbs" --arg sig "$(base64 -w0 <"$SIG")" '
        to_entries | map(
            .value |= map(
                if (.tbs // .pol) == $tbs then
                    .sig = $sig
                else
                    .
                end
            )
        ) | from_entries
    ' "$pcrs" >"${pcrs}.new"
    mv "${pcrs}.new" "$pcrs"
    cp "$pcrs" "${pcrs}.sig"
done < <(find hashes/pcrs -type f -name '*.sig')
rm -rf hashes/pcrs

while read -r PCRS; do
    uki="${PCRS%.pcrs.sig}.efi"
    ukify --json=short --pcrsig "@$PCRS" --join-pcrsig "$uki" --output "$uki.attached" build
    mv "$uki.attached" "$uki"
    mkdir -p next-hashes/ukis
    pesign --force -n sql:"$nss_db" -i "$uki" -E "next-hashes/ukis/$(basename "$uki")"
done < <(find "$OUTPUTDIR" -type f -name '*.pcrs.sig')
rm -f "$OUTPUTDIR"/*.pcrs*

if [ -d next-hashes/ukis ]; then
    # Only these new hashes need OBS signatures. Forward the remaining hashes
    # with their signatures and let the final worker edit the original disks.
    (cd hashes && find . -type f | cpio -H newc -o) >"$OUTPUTDIR/deferred-signatures.cpio"
    (cd next-hashes && find . -type f | cpio -H newc -o) >"$OUTPUTDIR/hashes.cpio.rsasign"
    cp /usr/src/packages/SOURCES/mkosi.conf "$OUTPUTDIR/"
    echo "Staging the following files for signing:"
    cpio -t <"$OUTPUTDIR/hashes.cpio.rsasign"
    rm -rf hashes next-hashes "$nss_db"
    exit 0
fi

certutil -A -d sql:"$nss_db" -n cert -t CT,CT,CT -i /usr/src/packages/SOURCES/_projectcert.crt
openssl x509 -inform PEM -in /usr/src/packages/SOURCES/_projectcert.crt -outform DER -out _projectcert.cer

# Keep the compressed original until all edits are done. A read-only ESP probe
# can then discard its working copy without recompressing the image.
declare -A ddi_modified=()
unpack_ddi() {
    if [[ -f "$1.zst" && -z ${ddi_modified[$1]+set} ]]; then
        unzstd --force "$1.zst"
        ddi_modified[$1]=0
    fi
}

# Set offset for mtools. Cache the probe as well for images postoutput didn't scan.
declare -A esp_offsets=()
prepare_esp() {
    local ddi="$1" src="/usr/src/packages/SOURCES/${1#"$OUTPUTDIR"/}"
    unpack_ddi "$ddi"
    if [[ -n ${esp_offsets[$ddi]+set} ]]; then
        offset="${esp_offsets[$ddi]}"
        return
    fi

    [[ ! -f "$ddi.zst" ]] || src+=.zst
    if [[ -f "$src.esp-offset" ]]; then
        IFS= read -r offset <"$src.esp-offset"
    else
        offset="$(systemd-repart --json=short "$ddi" | jq -r '.[] | select(.type == "esp") | .offset')"
    fi
    esp_offsets[$ddi]="$offset"
}

# Attach PE signatures to UKIs and kernels.
while read -r SIG; do
    sattrs="${SIG%.sig}"
    infile="${sattrs#hashes/*/}"
    test -f "/usr/src/packages/SOURCES/$infile" || continue
    test -s "$sattrs"

    DEST="$OUTPUTDIR/$infile"

    # ensure the EFI hash matches before and after attaching the signature
    old_hash=$(pesign -n sql:"$nss_db" -h -P -i "/usr/src/packages/SOURCES/$infile" | cut -d' ' -f1)

    pesign -n sql:"$nss_db" --force -c cert -i "/usr/src/packages/SOURCES/$infile" -o "$DEST" -d sha256 -I "$sattrs" -R "$SIG"

    new_hash=$(pesign -n sql:"$nss_db" -h -i "$DEST" | cut -d' ' -f1)
    if [ "$old_hash" != "$new_hash" ]; then
        echo "Pesign hash mismatch error: $old_hash $new_hash"
        exit 1
    fi

    # If there is a DDI with an ESP, add the UKI to it
    for ddi in "${DEST%efi}"{raw,raw.img,img}; do
        [[ -f "$ddi" || -f "$ddi.zst" ]] || continue
        prepare_esp "$ddi"
        if [ -z "$offset" ] || [ "$offset" = "null" ]; then
            continue
        fi
        mmd -D s -i "${ddi}@@${offset}" ::EFI ::EFI/Linux || true
        mcopy -o -i "${ddi}@@${offset}" "$DEST" "::EFI/Linux/$(basename "$DEST")"
        ddi_modified[$ddi]=1
    done
done < <(find hashes/ukis hashes/kernels -type f \( -name '*efi.sig' -o -name 'vmlinu*.sig' \))
rm -rf "$OUTPUTDIR"/*.sig hashes/ukis hashes/kernels

# Install signed bootloaders in the ESP.
while read -r BOOTLOADER; do
    unsigned="$(basename "${BOOTLOADER%.sig}")"
    signed="$(basename "${BOOTLOADER%.sig}".signed)"
    ddi="${OUTPUTDIR}/${BOOTLOADER%%/*}"
    # remove leading directory from BOOTLOADER
    dest="${BOOTLOADER#*/}"
    dest="${dest%.sig}"

    prepare_esp "$ddi"
    if [ -z "$offset" ] || [ "$offset" = "null" ]; then
        continue
    fi

    rm -f "$unsigned"
    mcopy -i "${ddi}@@${offset}" "::$dest" "$unsigned"

    # ensure the EFI hash matches before and after attaching the signature
    old_hash=$(pesign -n sql:"$nss_db" -h -P -i "$unsigned" | cut -d' ' -f1)

    pesign -n sql:"$nss_db" --force -c cert -i "$unsigned" -o "$signed" -d sha256 -I "hashes/bootloaders/${BOOTLOADER%.sig}" -R "hashes/bootloaders/${BOOTLOADER}"

    new_hash=$(pesign -n sql:"$nss_db" -h -i "$signed" | cut -d' ' -f1)
    if [ "$old_hash" != "$new_hash" ]; then
        echo "Pesign hash mismatch error: $old_hash $new_hash"
        exit 1
    fi

    mcopy -o -i "${ddi}@@${offset}" "$signed" "::$dest"
    ddi_modified[$ddi]=1
done < <(find hashes/bootloaders -type f -iname '*.efi.sig' -printf '%P\n')
rm -rf hashes/bootloaders
rm -rf nss-db

# Install EFI authvars for self-enrollment before splitting the ESP.
while read -r SIG; do
    varname="${SIG%.auth.sig}"
    auth="${varname}.auth"
    esl="${varname}.esl"
    p7s="${varname}.p7s"

    PATH=/usr/lib/systemd/:$PATH systemd-keyutil --certificate /usr/src/packages/SOURCES/_projectcert.crt --output "$p7s" --signature "$SIG" pkcs7

    rm -f "$auth"
    sign-efi-sig-list -t "$(date -d "@${SOURCE_DATE_EPOCH:-0}" "+%Y-%m-%d %H:%M:%S")" -i "$p7s" "$varname" "$esl" "$auth"
    rm -f "$esl" "$SIG" "$p7s"
done < <(find hashes/authvars -type f -name '*.auth.sig')
rm -f "$OUTPUTDIR"/*.esp-offset
declare -a AUTHVARS
mapfile -t AUTHVARS < <(find hashes/authvars -type f -name "*.auth")
if (( ${#AUTHVARS[@]} > 0 )); then
    for offset_file in /usr/src/packages/SOURCES/*.esp-offset; do
        [[ -f $offset_file ]] || continue
        image="${offset_file##*/}"
        image="${image%.esp-offset}"
        ddi="$OUTPUTDIR/${image%.zst}"
        prepare_esp "$ddi"

        mmd -D s -i "${ddi}@@${offset}" ::loader ::loader/keys ::loader/keys/auto || true
        for authvar in "${AUTHVARS[@]}"; do
            test -f "$authvar" || continue
            mcopy -o -i "${ddi}@@${offset}" "$authvar" "::loader/keys/auto/$(basename "$authvar")"
        done
        ddi_modified[$ddi]=1
    done
fi
rm -rf hashes/authvars

# Join verity signatures and split partitions from the final disk.
for bundle in /usr/src/packages/SOURCES/*.repart.tar; do
    [[ -f $bundle ]] || continue
    stem="${bundle##*/}"
    stem="${stem%.repart.tar}"
    work="$(mktemp -d "$OUTPUTDIR/.repart-XXXXXXXX")"
    tar xf "$bundle" -C "$work"
    rm -f "$OUTPUTDIR/${bundle##*/}"
    IFS= read -r image <"$work/image"
    if [[ -f $work/roothash ]]; then
        if ! PATH=/usr/lib/systemd/:$PATH systemd-keyutil --help | grep -q 'pkcs7'; then
            echo "Skipping verity signing for $image: systemd-keyutil lacks pkcs7 support" >&2
            rm -r "$work"
            continue
        fi
        PATH=/usr/lib/systemd/:$PATH systemd-keyutil --certificate /usr/src/packages/SOURCES/_projectcert.crt \
            --output "$work/roothash.p7s" --signature "hashes/roothashes/$image/$stem.roothash.sig" pkcs7
        # importctl would interpret this as a detached roothash for the whole disk.
        rm -f "$OUTPUTDIR/$stem.roothash"
    fi
    # repart creates splits next to the disk with O_EXCL; leave first-stage
    # artifacts in place until their replacements are ready.
    mkdir "$work/disk"
    ddi="$OUTPUTDIR/${image%.zst}"
    unpack_ddi "$ddi"
    ln "$ddi" "$work/disk/${ddi##*/}"
    mapfile -t args <"$work/options"
    args+=(--definitions "$work/definitions")
    [[ ! -f $work/usr/lib/os-release ]] || args+=(--root="$work")
    if [[ -f $work/roothash.p7s ]]; then
        args+=(--dry-run=no --join-signature "$(cat "$work/roothash"):$work/roothash.p7s" --certificate /usr/src/packages/SOURCES/_projectcert.crt)
        ddi_modified[$ddi]=1
    else
        # Without verity only the ESP was modified.
        args+=(--dry-run=yes --include-partitions=esp)
    fi
    partitions="$(systemd-repart --json=short "${args[@]}" "$work/disk/${ddi##*/}")"
    while IFS= read -r part; do
        if [[ $image == *.zst ]]; then
            zstd --rm "$part"
            part+=.zst
        fi
        mv -f "$part" "$OUTPUTDIR/"
    done < <(jq -r '.[].split_path | select(. and . != "-")' <<<"$partitions")
    rm -r "$work"
done
rm -rf hashes/roothashes

for ddi in "${!ddi_modified[@]}"; do
    [[ -f "$ddi.zst" ]] || continue
    if [[ ${ddi_modified[$ddi]} == 1 ]]; then
        zstd --force "$ddi"
    fi
    rm -f "$ddi"
done

rm -rf hashes "$nss_db"
